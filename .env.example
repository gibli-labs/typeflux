# Copy to .env for local development only.
# Keep this template free of real secrets; use blank values or placeholders here.
# Load real credentials from your shell, GitHub Secrets, or a secret manager.
# typeflux loads an explicit load_env(path), TYPEFLUX_ENV_FILE, or the current working directory .env only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Gemini Developer API key from https://aistudio.google.com/apikey
# (GOOGLE_API_KEY is accepted as a fallback). For Vertex AI instead, use
# Application Default Credentials + GOOGLE_CLOUD_PROJECT / _LOCATION.
GEMINI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# EU cloud:
LANGFUSE_HOST=https://cloud.langfuse.com

# US cloud alternative:
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# LangSmith prompt registry (runtime.registry.type: langsmith).
LANGSMITH_API_KEY=
# Optional self-hosted/region host (defaults to https://api.smith.langchain.com):
# LANGSMITH_HOST=https://api.smith.langchain.com
# Prompt name (or name:tag / name:commit) the live registry test resolves:
# TYPEFLUX_LANGSMITH_TEST_PROMPT=typeflux-contract-risk-review

TYPEFLUX_RUN_LIVE=1
TYPEFLUX_OPENAI_MODEL=gpt-4o-mini
TYPEFLUX_ANTHROPIC_MODEL=claude-sonnet-4-6
TYPEFLUX_GEMINI_MODEL=gemini-2.5-flash
TYPEFLUX_ENVIRONMENT=local
TYPEFLUX_DEPLOYMENT_ID=local-dev
TYPEFLUX_TEMPORAL_REGION=local

# Temporal local/self-hosted defaults. YAML examples consume these through
# runtime.temporal.* interpolation; setting an env var does nothing unless the
# YAML references it.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TLS=false
TEMPORAL_API_KEY=
TEMPORAL_TASK_QUEUE=typeflux-local

# Code provenance overrides (optional). Auto-detected from .git when unset;
# set all three in builds without a repository checkout (e.g. Docker images).
# TYPEFLUX_GIT_SHA=
# TYPEFLUX_GIT_REF=
# TYPEFLUX_REPO_URL=
